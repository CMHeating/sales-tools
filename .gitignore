# --- Secrets: never commit ---
# PIN config and Firebase Auth artifacts. See INSTALL-AVAILABILITY-SECURITY.md.
# Catch-all patterns first so a new *.private.* file is ignored by default.
*.private.json
*.private.txt
pin-config.private.json
install-secret-one-line.private.txt
install-auth-users.spark.private.json
firebase.hosting-install-only.json
firebase.database-spark-only.json

# Spreadsheet exports at the repo root. unsold-followup-report.xlsx was committed
# here on 2026-05-18 carrying customer names, addresses and phone numbers and was
# served by GitHub Pages until 2026-08-29. Exports go to the Daily Uploads Drive
# folder, never here. Scoped to the root on purpose: data/vendor-pricing/ holds a
# tracked vendor pricebook that must keep working.
/*.xlsx
/*.xlsm
/*.csv

# Deploy staging directory. The Hosting deploy recipe in
# INSTALL-AVAILABILITY-SECURITY.md rebuilds this with rm -rf on every deploy,
# so nothing in it may be tracked — anything tracked here gets destroyed.
firebase-hosting-install/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
firebase-debug.*.log*

# Firebase cache
.firebase/

# Firebase config

# Uncomment this if you'd like others to create their own Firebase project.
# For a team working on the same Firebase project(s), it is recommended to leave
# it commented so all members can deploy to the same project(s) in .firebaserc.
# .firebaserc

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# dataconnect generated files
.dataconnect

# graphify knowledge graph — rebuild locally; commit only a full graph (needs LLM key for the HTML tools)
graphify-out/
# root copy of the report is a one-off convenience (T-1.2); the post-commit hook refreshes graphify-out/GRAPH_REPORT.md, not this
GRAPH_REPORT.md

# --- Session handoffs: never commit ---
# HANDOFF.local.md is the rolling handoff between sessions. It routinely names
# customers, job numbers, AR balances and Gmail draft IDs, and this repo is
# published to GitHub Pages. The SessionStart brief hook reads it from disk;
# it is never meant to travel through git.
*.local.md
